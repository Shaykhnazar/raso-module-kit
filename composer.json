{
    "name": "raso/module-kit",
    "description": "Raso OS modul-servislari uchun umumiy yadro: domen primitivlari, auth, event bus va sifat gate shablonlari",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^7.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/uid": "^7.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.0",
        "illuminate/cache": "^13.0",
        "laravel/pint": "^1.18",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Raso\\ModuleKit\\": "src/"
        },
        "files": [
            "src/Testing/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Raso\\ModuleKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@pint-test",
            "@stan",
            "@deptrac",
            "@test"
        ],
        "pint": "pint",
        "pint-test": "pint --test",
        "stan": "phpstan analyse --memory-limit=1G",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress",
        "test": "pest --parallel"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Raso\\ModuleKit\\Laravel\\ModuleKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
